NEXT_PUBLIC_LEAD_CAPTURE_ENDPOINT=https://srnynewvauzymnljqskj.supabase.co/functions/v1/so-anfrage

# Supabase Edge Function secrets. Set these with `supabase secrets set`, NOT in Vercel.
